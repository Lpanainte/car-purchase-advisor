@model CarPurchaseAdvisor.Models.Car

<style>

    body {
        background: linear-gradient(to right,#0f172a,#1e293b);
        color: white;
        font-family: Arial;
    }

    .container {
        width: 1000px;
        margin: auto;
        margin-top: 50px;
        background: #111827;
        padding: 40px;
        border-radius: 25px;
        box-shadow: 0 0 25px rgba(124,58,237,0.3);
    }

    img {
        width: 100%;
        border-radius: 20px;
        margin-bottom: 30px;
        transition: 0.3s;
    }

        img:hover {
            transform: scale(1.01);
        }

    h1 {
        font-size: 55px;
        margin-bottom: 10px;
    }

    .subtitle {
        color: #94a3b8;
        margin-bottom: 40px;
        font-size: 20px;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 20px;
        margin-top: 30px;
    }

    .card {
        background: #1f2937;
        padding: 25px;
        border-radius: 20px;
    }

        .card h2 {
            margin: 0;
            font-size: 18px;
            color: #94a3b8;
        }

        .card p {
            font-size: 28px;
            margin-top: 10px;
        }

    .back-btn {
        display: inline-block;
        margin-top: 40px;
        background: linear-gradient(to right,#7c3aed,#2563eb);
        color: white;
        padding: 15px 25px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: bold;
    }

    .badge {
        display: inline-block;
        padding: 10px 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .electric {
        background: #10b981;
    }

    .petrol {
        background: #ef4444;
    }

</style>

<div class="container">

    <div class="badge @(Model.FuelType == "Electric" ? "electric" : "petrol")">

        @Model.FuelType

    </div>

    <h1>
        @Model.Brand @Model.Model
    </h1>

    <p class="subtitle">
        2026 premium performance vehicle
    </p>

    <img src="@Model.ImageUrl" />

    <div class="stats">

        <div class="card">
            <h2>Year</h2>
            <p>@Model.Year</p>
        </div>

        <div class="card">
            <h2>Price</h2>
            <p>@Model.Price €</p>
        </div>

        <div class="card">
            <h2>Fuel Type</h2>
            <p>@Model.FuelType</p>
        </div>

        <div class="card">
            <h2>Horsepower</h2>
            <p>@Model.Horsepower HP</p>
        </div>

    </div>

    <a href="/Home/Index" class="back-btn">
        Back to Cars
    </a>

</div>