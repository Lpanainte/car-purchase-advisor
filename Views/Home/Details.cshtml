@model CarPurchaseAdvisor.Models.Car

<style>
    body {
        background: linear-gradient(to right, #0f172a, #1e293b);
        color: white;
        font-family: Arial;
    }

    .details-container {
        width: 92%;
        max-width: 1400px;
        margin: auto;
        margin-top: 45px;
    }

    .details-card {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 35px;
        background: #0b1120;
        padding: 35px;
        border-radius: 32px;
        box-shadow: 0 0 45px rgba(124, 58, 237, 0.25);
        border: 1px solid rgba(124, 58, 237, 0.25);
    }

    .car-main-image {
        width: 100%;
        height: 620px;
        object-fit: cover;
        border-radius: 28px;
        box-shadow: 0 0 35px rgba(0,0,0,0.45);
    }

    .details-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .brand-label {
        color: #a855f7;
        font-size: 18px;
        font-weight: bold;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .details-info h1 {
        font-size: 62px;
        margin-bottom: 12px;
        line-height: 1.05;
    }

    .details-info h2 {
        font-size: 34px;
        color: #cbd5e1;
        margin-bottom: 30px;
    }

    .price-box {
        background: linear-gradient(to right, #7c3aed, #2563eb);
        padding: 22px;
        border-radius: 22px;
        font-size: 34px;
        font-weight: bold;
        margin-bottom: 28px;
        text-align: center;
        box-shadow: 0 0 30px rgba(124,58,237,0.25);
    }

    .specs-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
        margin-bottom: 30px;
    }

    .spec-card {
        background: #111827;
        padding: 22px;
        border-radius: 20px;
        border: 1px solid rgba(148, 163, 184, 0.12);
        box-shadow: 0 0 18px rgba(0,0,0,0.25);
    }

        .spec-card span {
            display: block;
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .spec-card strong {
            font-size: 24px;
            color: white;
        }

    .actions {
        display: flex;
        gap: 15px;
        margin-top: 10px;
    }

    .btn {
        background: linear-gradient(to right, #7c3aed, #2563eb);
        color: white;
        padding: 16px 24px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: bold;
        transition: 0.3s;
        border: none;
        cursor: pointer;
        font-size: 17px;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .favorite-details-btn {
        background: linear-gradient(to right, #ec4899, #ef4444);
    }
</style>

<div class="details-container">

    <div class="details-card">

        <div>
            <img src="@Model.ImageUrl"
                 class="car-main-image"
                 onerror="this.src='/images/hero.jpg'" />
        </div>

        <div class="details-info">

            <div class="brand-label">
                Premium Car Details
            </div>

            <h1>@Model.Brand</h1>

            <h2>@Model.Model</h2>

            <div class="price-box">
                @Model.Price.ToString("N0") €
            </div>

            <div class="specs-grid">

                <div class="spec-card">
                    <span>Year</span>
                    <strong>@Model.Year</strong>
                </div>

                <div class="spec-card">
                    <span>Fuel Type</span>
                    <strong>@Model.FuelType</strong>
                </div>

                <div class="spec-card">
                    <span>Horsepower</span>
                    <strong>@Model.Horsepower HP</strong>
                </div>

                <div class="spec-card">
                    <span>Category</span>
                    <strong>Luxury</strong>
                </div>

            </div>

            <div class="actions">

                <a href="/Home/Index" class="btn">
                    ⬅ Back to Cars
                </a>

                <a href="/Home/Edit/@Model.Id" class="btn">
                    ✏️ Edit
                </a>

                <button class="btn favorite-details-btn"
                        onclick="addToFavorites('@Model.Id')">
                    ❤️ Add to Favourites
                </button>

            </div>

        </div>

    </div>

</div>

<script>
    function addToFavorites(carId) {
        let favorites = JSON.parse(localStorage.getItem("favorites")) || [];

        carId = carId.toString();

        if (!favorites.includes(carId)) {
            favorites.push(carId);
            localStorage.setItem("favorites", JSON.stringify(favorites));
            alert("Car added to favourites!");
        } else {
            alert("This car is already in favourites.");
        }
    }
</script>