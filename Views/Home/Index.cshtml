@model List<CarPurchaseAdvisor.Models.Car>

<style>

    body {
        background: linear-gradient(to right, #0f172a, #1e293b);
        color: white;
        font-family: Arial;
    }

    .container {
        width: 95%;
        max-width:1800px;
        margin: auto;
        margin-top: 40px;
    }

    h1 {
        font-size: 60px;
        margin-bottom: 10px;
    }

    .subtitle {
        color: #94a3b8;
        margin-bottom: 40px;
    }

.btn{
    background:
    linear-gradient(
    to right,
    #7c3aed,
    #2563eb);

    color:white;

    padding:22px;

    border-radius:18px;

    text-decoration:none;

    font-weight:bold;

    transition:0.3s;

    display:flex;

    justify-content:center;

    align-items:center;

    gap:10px;

    font-size:18px;

    box-shadow:
    0 0 20px rgba(124,58,237,0.18);
    position:relative;

overflow:hidden;
}

        .btn:hover {
            transform: scale(1.05);
        }
        .btn::before{
    content:"";

    position:absolute;

    width:220px;
    height:220px;

    background:rgba(255,255,255,0.08);

    border-radius:50%;

    top:-120px;
    right:-120px;
}
    .edit-btn {
        background: #2563eb;
        color: white;
        padding: 10px 15px;
        border-radius: 10px;
        text-decoration: none;
        margin-right: 10px;
    }

    .delete-btn {
        background: red;
        color: white;
        padding: 10px 15px;
        border-radius: 10px;
        text-decoration: none;
    }
    .favorite-btn{
    background:#374151;
    border:none;
    color:white;
    padding:10px 15px;
    border-radius:10px;
    cursor:pointer;
    margin-right:10px;
    font-size:20px;
    width:50px;

height:50px;

display:flex;

align-items:center;

justify-content:center;
}



    table {
        width: 100%;
        margin-top: 30px;
       border-collapse:separate;
border-spacing:0 14px;
        background: #111827;
        border-radius: 20px;
        overflow: hidden;
        box-shadow:
0 0 40px rgba(0,0,0,0.35);
    }
    tr{
    background:#0b1120;

    transition:0.3s;
}

tr:hover{
    transform:scale(1.01);

    background:#111827;
}

   th{
   background:linear-gradient(
to right,
#131c31,
#1e293b);

    padding:24px;

    text-align:center;

    color:#cbd5e1;

   font-size:13px;

    letter-spacing:1px;

    text-transform:uppercase;
}

   td {
 padding:24px 16px;
    border-bottom: 1px solid #374151;
    text-align:center;
    vertical-align:middle;
}

    tr:hover {
        background: #1e293b;
    }

    img {
        border-radius: 15px;
        transition: 0.3s;
    }

        img:hover {
            transform: scale(1.05);
        }

.top-dashboard{
    display:inline-flex;
    align-items:center;

    gap:18px;

    background:rgba(11,17,32,0.85);

    padding:18px;

    border-radius:24px;

    margin-bottom:25px;

    border:1px solid rgba(124,58,237,0.18);

    box-shadow:
    0 0 30px rgba(124,58,237,0.12);

    overflow-x:auto;
}


.mini-favorite-btn{
    background:linear-gradient(to right,#ec4899,#ef4444);

    padding:16px 24px;

    border-radius:16px;

    color:white;

    text-decoration:none;

    font-size:18px;

    font-weight:bold;

    white-space:nowrap;

    box-shadow:
    0 0 20px rgba(236,72,153,0.25);

    transition:0.3s;
}

.mini-favorite-btn:hover{
    transform:scale(1.05);
}



.hero-image{
    width:100%;

 height:550px;

    object-fit:cover;

    border-radius:28px;

    margin-top:20px;
    margin-bottom:30px;

    box-shadow:
    0 0 40px rgba(124,58,237,0.25);
}
.mini-stat{
    background:#0b1120;

    padding:16px 22px;

    border-radius:18px;

    min-width:150px;
    min-height:150px;
    position:relative;
overflow:hidden;

    text-align:left;

    border:1px solid rgba(124,58,237,0.12);

    box-shadow:
    0 0 18px rgba(124,58,237,0.12);

    transition:0.3s;
    display:flex;

flex-direction:column;

justify-content:center;
}

.mini-stat:hover{
    transform:translateY(-5px);
}

.mini-stat h3{
    color:white;

    font-size:42px;

    margin-bottom:4px;
}

.mini-stat p{
    color:#94a3b8;

    font-size:14px;
}
.mini-stat::before{
    content:"";

    position:absolute;

    width:180px;
    height:180px;

    background:rgba(124,58,237,0.08);

    border-radius:50%;

    top:-90px;
    right:-90px;
}
.dashboard-wrapper{
    margin-top:25px;
}

.action-buttons{
    display:grid;

    grid-template-columns:
    repeat(3, 1fr);

    gap:20px;

    margin-bottom:25px;
}
.search-section{
    display:flex;

    gap:20px;

    background:#081020;

    padding:10px;

    border-radius:22px;

    margin-bottom:25px;

    border:1px solid rgba(124,58,237,0.15);

    box-shadow:
    0 0 25px rgba(124,58,237,0.08);
}

.stats-row{
    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:16px;

    margin-bottom:30px;
}
.favorite-card{
    background:linear-gradient(
    to right,
    #ec4899,
    #ef4444);

    border-radius:24px;

    padding:18px;

    min-height:150px;

    color:white;

    text-decoration:none;

    display:flex;

    align-items:center;

    justify-content:center;

    box-shadow:
    0 0 30px rgba(236,72,153,0.22);

    transition:0.3s;

    position:relative;

    overflow:hidden;

    max-width:100%;
    box-sizing:border-box;
}

.favorite-card:hover{
    transform:translateY(-5px);
    background-position:right center;
}

.favorite-card h3{
    font-size:24px;

    margin-bottom:10px;

    font-weight:800;
}

.favorite-card p{
    opacity:0.9;
}
.favorite-card::before{
    content:"";

    position:absolute;

    width:320px;
    height:320px;

    background:rgba(255,255,255,0.08);

    border-radius:50%;

    top:-160px;
    right:-120px;
}
#fuelFilter{
    flex:1;

    height:52px;

    padding:0 22px;

    border-radius:20px;

    border:1px solid rgba(124,58,237,0.2);

    background:#0b1120;

    color:white;

    font-size:17px;

    outline:none;
}
#searchInput{
    flex:1.7;

    height:54px;

    padding-left:24px;

    border:none;

    border-radius:20px;

    background:#0b1120;

    color:white;

    outline:none;

    font-size:17px;
}
.hero-section{
    position:relative;
}

.hero-overlay{
    position:absolute;

    top:54%;
    left:90px;

    transform:translateY(-50%);

    z-index:2;

    max-width:720px;
}
.hero-overlay p{
    color:#a855f7;

    font-weight:bold;

    letter-spacing:2px;

    margin-bottom:10px;
}

.hero-overlay h2{
    font-size:64px;

    line-height:1.05;

    margin-bottom:20px;
}
.hero-overlay span{
    display:block;

    color:#cbd5e1;

    font-size:18px;

    max-width:620px;

    margin-bottom:30px;

    line-height:1.7;

    opacity:0.9;
}

.hero-overlay a{
    background:linear-gradient(to right,#7c3aed,#2563eb);

    padding:16px 26px;

    border-radius:16px;

    color:white;

    text-decoration:none;

    font-weight:bold;

    display:inline-block;
}

.hero-image{
    filter:brightness(0.5);
}



</style>

<div class="container">


<div class="hero-section">

    <div class="hero-overlay">

       <p>WHERE LUXURY MEETS PERFORMANCE</p>

        <h2>
            Find Your Dream Car
        </h2>

        <span>
            Discover the latest 2026 luxury,
            electric and high-performance vehicles.
        </span>

    </div>

    <img src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=1600&auto=format&fit=crop"
         class="hero-image" />

</div>

</div>
<div class="dashboard-wrapper">

    <div class="action-buttons">

        <a href="/Home/Create" class="btn">
            🚗 Add New Car
        </a>

        <a href="/Home/Quiz" class="btn">
            ⚡ Smart Quiz
        </a>

        <a href="/Home/Compare" class="btn">
            ⚖️ Compare Cars
        </a>

    </div>

    <div class="search-section">

        <input type="text"
               id="searchInput"
               placeholder="🔍 Search cars by brand, model..." />

        <select id="fuelFilter">

            <option value="all">⛽ All Fuel Types</option>
            <option value="Petrol">Petrol</option>
            <option value="Electric">Electric</option>
            <option value="Hybrid">Hybrid</option>

        </select>

    </div>

    <div class="stats-row">

        <div class="mini-stat">
            <h3>🚘 @Model.Count</h3>
            <p>Total Cars</p>
        </div>

        <div class="mini-stat">
            <h3>📅 2026</h3>
            <p>Latest Models</p>
        </div>

        <div class="mini-stat">
            <h3>⚡ 1000+</h3>
            <p>Horsepower</p>
        </div>

   

    </div>

</div>
   


    <table>
       

        <tr>

            <th>Image</th>
           <th>Brand</th>
            <th>Model</th>
            <th>Year</th>
            <th>Price</th>
            <th>Fuel</th>
            <th>Horsepower</th>
            <th style="width:220px; text-align:center;">
    Actions
</th>
  
        </tr>
        @foreach (var car in Model)
{
    <tr>
     <td>
    <img src="@car.ImageUrl"
         width="240" />
</td>

<td>
    @car.Brand
</td>

<td>
    @car.Model
</td>

<td>
    @car.Year
</td>

<td>
    @car.Price €
</td>


                <td>

                    @if (car.FuelType == "Electric")
                    {
                        <span style="
                            background:#10b981;
                            padding:8px 12px;
                            border-radius:10px;
                            font-weight:bold;">
                            Electric
                        </span>
                    }
                    else if (car.FuelType == "Hybrid")
                    {
                        <span style="
                            background:#f59e0b;
                            padding:8px 12px;
                            border-radius:10px;
                            font-weight:bold;">
                            Hybrid
                        </span>
                    }
                    else
                    {
                        <span style="
                            background:#ef4444;
                            padding:8px 12px;
                            border-radius:10px;
                            font-weight:bold;">
                            Petrol
                        </span>
                    }

                </td>

                <td>@car.Horsepower HP</td>
               

              <td style="text-align:center;">

                  <div style="
   display:inline-flex;
    justify-content:center;
    align-items:center;
    gap:10px;">

<button class="favorite-btn"
        data-id="@car.Id"
        onclick="toggleFavorite(this, '@car.Id')">

    ♡

</button>
<a href="/Home/Edit/@car.Id"
   class="edit-btn">
   ✏️
</a>

<a href="/Home/Delete/@car.Id"
   class="delete-btn"
   onclick="return confirm('Are you sure you want to delete this car?')">
   🗑️
</a>
    </div>
</td>

            </tr>
        }

    </table>


<script>

    const searchInput =
        document.getElementById("searchInput");

    searchInput.addEventListener("keyup", function () {

        let filter =
            searchInput.value.toLowerCase();

        let rows =
            document.querySelectorAll("table tr");

        rows.forEach((row, index) => {

            if (index === 0) return;

            let text =
                row.innerText.toLowerCase();

            row.style.display =
                text.includes(filter)
                ? ""
                : "none";
        });
    });

</script>

<script> let favorites = JSON.parse(localStorage.getItem("favorites")) || []; function toggleFavorite(button, carId) { carId = carId.toString(); if(favorites.includes(carId)) { favorites = favorites.filter(x => x !== carId); button.innerHTML = "♡"; button.style.background = "#374151"; } else { favorites.push(carId); button.innerHTML = "♥"; button.style.background = "#ef4444"; } localStorage.setItem( "favorites", JSON.stringify(favorites) ); } window.onload = function() { let buttons = document.querySelectorAll(".favorite-btn"); buttons.forEach((button) => { let carId = button.getAttribute("data-id"); if(favorites.includes(carId)) { button.innerHTML = "♥"; button.style.background = "#ef4444"; } }); } </script>